-- ════════════════════════════════════════════════════════════════════════
-- MobileSupport.lua — Drop-in mobile/touch layer for LinoriaLib scripts
-- ════════════════════════════════════════════════════════════════════════

local MobileSupport = {}

local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local _overlays = {}
local _connections = {}
local _initialized = false
local _getupvalues = (debug and debug.getupvalues) or getupvalues or nil

function MobileSupport.isMobile()
	return UIS.TouchEnabled and not UIS.MouseEnabled and not UIS.KeyboardEnabled
end

-- ═══ HELPERS ════════════════════════════════════════════════════════════

local function addConn(conn)
	if conn then table.insert(_connections, conn) end
end

local function addOverlay(obj)
	if obj then table.insert(_overlays, obj) end
end

local function isTouchOrClick(input)
	local t = input.UserInputType
	return t == Enum.UserInputType.Touch or t == Enum.UserInputType.MouseButton1
end

local function isTouchOrMouseMove(input)
	local t = input.UserInputType
	return t == Enum.UserInputType.Touch or t == Enum.UserInputType.MouseMovement
end

local function isFrameVisible(frame)
	if not frame then return false end
	local current = frame
	while current do
		if current:IsA("GuiObject") then
			if not current.Visible then return false end
		end
		if current:IsA("BasePlayerGui") or current:IsA("CoreGui") then break end
		current = current.Parent
	end
	return true
end

local function isInsideFrame(pos, frame)
	if not frame then return false end
	local ap = frame.AbsolutePosition
	local as = frame.AbsoluteSize
	return pos.X >= ap.X and pos.X <= ap.X + as.X
		and pos.Y >= ap.Y and pos.Y <= ap.Y + as.Y
end

local function findFrameUpvalues(func)
	if not _getupvalues or not func then return {} end
	local ok, ups = pcall(_getupvalues, func)
	if not ok or type(ups) ~= "table" then return {} end
	local frames = {}
	for _, v in pairs(ups) do
		if typeof(v) == "Instance" and v:IsA("Frame") then
			table.insert(frames, v)
		end
	end
	return frames
end

local function roundValue(raw, rounding)
	if rounding == 0 then return math.floor(raw + 0.5) end
	local mult = 10 ^ rounding
	return math.floor(raw * mult + 0.5) / mult
end

-- toggle.Container is the GROUPBOX (too large for hit-testing).
-- The actual row frame is TextLabel -> ToggleInner -> ToggleOuter.
local function getToggleHitFrame(toggle)
	if toggle.TextLabel and typeof(toggle.TextLabel) == "Instance" then
		local inner = toggle.TextLabel.Parent
		if inner and typeof(inner) == "Instance" and inner:IsA("GuiObject") then
			local outer = inner.Parent
			if outer and typeof(outer) == "Instance" and outer:IsA("GuiObject") then
				return outer
			end
			return inner
		end
	end
	return nil
end

local function findOuterFrame(screenGui)
	for _, child in ipairs(screenGui:GetChildren()) do
		if child:IsA("Frame") then return child end
	end
	return nil
end

-- ═══ UI SCALE ═══════════════════════════════════════════════════════════

local _scaleInstance = nil

local function applyScale(screenGui)
	local ok, viewport = pcall(function() return workspace.CurrentCamera.ViewportSize end)
	if not ok then return end
	local factor = viewport.X < 700 and 1.5 or 1.25
	local outerFrame = findOuterFrame(screenGui)
	if outerFrame then
		if _scaleInstance then pcall(function() _scaleInstance:Destroy() end) end
		_scaleInstance = Instance.new("UIScale")
		_scaleInstance.Scale = factor
		_scaleInstance.Parent = outerFrame
	end
end

-- ═══ SLIDER SUPPORT (overlay approach — proven working) ═════════════════

local function findSliderBar(slider)
	if _getupvalues then
		if slider.Display then
			local frames = findFrameUpvalues(slider.Display)
			for _, f in ipairs(frames) do
				local parent = f.Parent
				if parent and parent:IsA("Frame") and parent.AbsoluteSize.X > 50 then
					return parent
				end
			end
		end
		if slider.GetValueFromXOffset then
			local frames = findFrameUpvalues(slider.GetValueFromXOffset)
			for _, f in ipairs(frames) do
				if f.AbsoluteSize.X > 50 and f.AbsoluteSize.Y < 30 then return f end
			end
		end
	end
	return nil
end

local function hookSliders()
	local options = getgenv and getgenv().Options
	if not options then return end

	for idx, element in pairs(options) do
		if element.Type and element.Type == "Slider" then
			local bar = findSliderBar(element)
			if bar then
				local overlay = Instance.new("TextButton")
				overlay.Name = "MO_S_" .. tostring(idx)
				overlay.Text = ""
				overlay.BackgroundTransparency = 1
				overlay.BorderSizePixel = 0
				overlay.ZIndex = 999
				overlay.AutoButtonColor = false
				overlay.Active = true
				overlay.Size = UDim2.new(1, 16, 1, 20)
				overlay.Position = UDim2.new(0, -8, 0, -10)
				overlay.Parent = bar
				addOverlay(overlay)

				local dragging = false
				local function updateFromPos(posX)
					local rel = math.clamp(
						(posX - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1
					)
					local raw = element.Min + (element.Max - element.Min) * rel
					pcall(function() element:SetValue(roundValue(raw, element.Rounding or 0)) end)
				end

				overlay.InputBegan:Connect(function(input)
					if isTouchOrClick(input) then
						dragging = true
						updateFromPos(input.Position.X)
					end
				end)
				overlay.InputEnded:Connect(function(input)
					if isTouchOrClick(input) then dragging = false end
				end)
				addConn(UIS.InputChanged:Connect(function(input)
					if dragging and isTouchOrMouseMove(input) then
						updateFromPos(input.Position.X)
					end
				end))
			end
		end
	end
end

-- ═══ HIDE KEYBINDS ══════════════════════════════════════════════════════

local function hideKeybinds()
	local options = getgenv and getgenv().Options
	if not options then return end
	for _, element in pairs(options) do
		if element.Type and element.Type == "KeyPicker" then
			pcall(function()
				if element.Container then element.Container.Visible = false end
			end)
		end
	end
end

-- ═══ TAB SUPPORT ════════════════════════════════════════════════════════

local _cachedTabButtons = nil
local _firesignal = nil

local function getFiresignal()
	if _firesignal ~= nil then return _firesignal end
	_firesignal = firesignal
		or (getgenv and getgenv().firesignal)
		or false
	return _firesignal
end

local function findTabButtons(outerFrame)
	if _cachedTabButtons then return _cachedTabButtons end
	local results = {}
	local outerAP = outerFrame.AbsolutePosition

	for _, desc in ipairs(outerFrame:GetDescendants()) do
		if desc:IsA("Frame") or desc:IsA("TextButton") or desc:IsA("TextLabel") then
			local ok, relY, h, w = pcall(function()
				return desc.AbsolutePosition.Y - outerAP.Y,
				       desc.AbsoluteSize.Y,
				       desc.AbsoluteSize.X
			end)
			if ok and relY > 15 and relY < 70 and h > 10 and h < 40 and w > 30 and w < 250 then
				local hasText = false
				if desc:IsA("TextLabel") or desc:IsA("TextButton") then
					hasText = desc.Text ~= ""
				else
					local label = desc:FindFirstChildWhichIsA("TextLabel")
					if label and label.Text ~= "" then hasText = true end
				end
				if hasText then
					table.insert(results, desc)
				end
			end
		end
	end

	-- Real tab bars have 2+ buttons sharing a parent; filter out lone title labels
	local byParent = {}
	for _, btn in ipairs(results) do
		local p = btn.Parent
		if p then
			if not byParent[p] then byParent[p] = {} end
			table.insert(byParent[p], btn)
		end
	end
	local filtered = {}
	for _, group in pairs(byParent) do
		if #group >= 2 then
			for _, btn in ipairs(group) do
				table.insert(filtered, btn)
			end
		end
	end

	_cachedTabButtons = filtered
	return filtered
end

local function fireTabClick(tabBtn)
	local fs = getFiresignal()
	if not fs then return false end

	-- LinoriaLib's InputBegan handler is on the tab button Frame, not its TextLabel
	local target = tabBtn
	if tabBtn:IsA("TextLabel") then
		local p = tabBtn.Parent
		if p and (p:IsA("Frame") or p:IsA("TextButton")) then
			target = p
		end
	end

	local fired = false
	pcall(function()
		fs(target.InputBegan, {
			UserInputType = Enum.UserInputType.MouseButton1,
			Position = Vector3.new(
				target.AbsolutePosition.X + target.AbsoluteSize.X / 2,
				target.AbsolutePosition.Y + target.AbsoluteSize.Y / 2,
				0
			)
		})
		fired = true
	end)
	return fired
end

-- ═══ GLOBAL TOUCH HANDLER ═══════════════════════════════════════════════

local function hookGlobalTouch(screenGui)
	local lastToggleTap = 0
	local windowDragging = false
	local windowDragStart = nil
	local windowStartPos = nil
	local windowDragFrame = nil

	addConn(UIS.InputBegan:Connect(function(input)
		if not isTouchOrClick(input) then return end
		local pos = input.Position

		local outerFrame = findOuterFrame(screenGui)
		if not outerFrame or not outerFrame.Visible then return end
		if not isInsideFrame(pos, outerFrame) then return end

		-- 1. toggles — hit-test each toggle's individual row frame
		local toggles = getgenv and getgenv().Toggles
		if toggles then
			for idx, toggle in pairs(toggles) do
				local hitFrame = getToggleHitFrame(toggle)
				if hitFrame and isFrameVisible(hitFrame) and isInsideFrame(pos, hitFrame) then
					local now = tick()
					if now - lastToggleTap > 0.3 then
						lastToggleTap = now
						pcall(function() toggle:SetValue(not toggle.Value) end)
					end
					return
				end
			end
		end

		-- 2. tabs
		local tabButtons = findTabButtons(outerFrame)
		for _, tabBtn in ipairs(tabButtons) do
			if isInsideFrame(pos, tabBtn) then
				fireTabClick(tabBtn)
				return
			end
		end

		-- 3. window title bar drag (top 55px)
		local ap = outerFrame.AbsolutePosition
		if pos.Y <= ap.Y + 55 then
			windowDragging = true
			windowDragStart = pos
			windowStartPos = outerFrame.Position
			windowDragFrame = outerFrame
			return
		end
	end))

	addConn(UIS.InputChanged:Connect(function(input)
		if windowDragging and isTouchOrMouseMove(input) and windowDragStart and windowDragFrame then
			local delta = input.Position - windowDragStart
			windowDragFrame.Position = UDim2.new(
				windowStartPos.X.Scale, windowStartPos.X.Offset + delta.X,
				windowStartPos.Y.Scale, windowStartPos.Y.Offset + delta.Y
			)
		end
	end))

	addConn(UIS.InputEnded:Connect(function(input)
		if isTouchOrClick(input) then
			windowDragging = false
			windowDragStart = nil
		end
	end))
end

-- ═══ MENU TOGGLE BUTTON ═════════════════════════════════════════════════

local function addMenuToggleButton(screenGui)
	local btn = Instance.new("TextButton")
	btn.Name = "MO_MenuToggle"
	btn.Text = "="
	btn.Font = Enum.Font.GothamBold
	btn.TextSize = 22
	btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	btn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
	btn.BackgroundTransparency = 0.25
	btn.Size = UDim2.new(0, 46, 0, 46)
	btn.Position = UDim2.new(0, 12, 0.5, -23)
	btn.ZIndex = 9999
	btn.AutoButtonColor = false
	btn.Active = true
	btn.BorderSizePixel = 0
	btn.Parent = screenGui
	addOverlay(btn)

	pcall(function()
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 10)
		corner.Parent = btn
	end)
	pcall(function()
		local stroke = Instance.new("UIStroke")
		stroke.Color = Color3.fromRGB(80, 80, 80)
		stroke.Thickness = 1
		stroke.Parent = btn
	end)

	local btnDragStart = nil
	local btnStartPos = nil
	local btnWasDragged = false

	addConn(UIS.InputBegan:Connect(function(input)
		if not isTouchOrClick(input) then return end
		if isInsideFrame(input.Position, btn) then
			btnDragStart = input.Position
			btnStartPos = btn.Position
			btnWasDragged = false
		end
	end))

	addConn(UIS.InputChanged:Connect(function(input)
		if btnDragStart and isTouchOrMouseMove(input) then
			local delta = input.Position - btnDragStart
			if delta.Magnitude > 10 then
				btnWasDragged = true
				btn.Position = UDim2.new(
					btnStartPos.X.Scale, btnStartPos.X.Offset + delta.X,
					btnStartPos.Y.Scale, btnStartPos.Y.Offset + delta.Y
				)
			end
		end
	end))

	addConn(UIS.InputEnded:Connect(function(input)
		if not isTouchOrClick(input) then return end
		if btnDragStart and not btnWasDragged then
			local outerFrame = findOuterFrame(screenGui)
			if outerFrame then
				outerFrame.Visible = not outerFrame.Visible
			end
		end
		btnDragStart = nil
		btnWasDragged = false
	end))
end

-- ═══ VIEWPORT HANDLER ═══════════════════════════════════════════════════

local function watchViewport(screenGui)
	pcall(function()
		addConn(workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
			applyScale(screenGui)
		end))
	end)
end

-- ═══ PUBLIC API ═════════════════════════════════════════════════════════

function MobileSupport.Init(Library)
	if not MobileSupport.isMobile() then return end
	if _initialized then return end
	_initialized = true

	local screenGui = Library.ScreenGui
	if not screenGui then
		warn("[MobileSupport] Library.ScreenGui not found")
		return
	end

	pcall(applyScale, screenGui)
	task.wait(0.15)

	pcall(hookSliders)
	pcall(hideKeybinds)
	pcall(hookGlobalTouch, screenGui)
	pcall(addMenuToggleButton, screenGui)
	pcall(watchViewport, screenGui)
end

function MobileSupport.Destroy()
	_initialized = false
	_cachedTabButtons = nil
	for _, conn in ipairs(_connections) do
		pcall(function() conn:Disconnect() end)
	end
	for _, obj in ipairs(_overlays) do
		pcall(function() obj:Destroy() end)
	end
	if _scaleInstance then
		pcall(function() _scaleInstance:Destroy() end)
		_scaleInstance = nil
	end
	table.clear(_connections)
	table.clear(_overlays)
end

return MobileSupport
